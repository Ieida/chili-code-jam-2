[sub_resource type="GDScript" id="GDScript_ek21h"]
resource_name = "sprite"
script/source = "extends AnimatedSprite3D


func _process(_delta: float) -> void:
	var shdr = material_override as ShaderMaterial
	var tex = sprite_frames.get_frame_texture(animation, frame)
	shdr.set_shader_parameter(\"tex\", tex)
"

[sub_resource type="GDScript" id="GDScript_bmxbo"]
